<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.example.receiptbox-backup</string>
<key>ProgramArguments</key><array><string>/opt/homebrew/bin/node</string><string>/Users/YOUR_USER/receiptbox/current/src/backup.mjs</string></array>
<key>WorkingDirectory</key><string>/Users/YOUR_USER/receiptbox</string>
<key>EnvironmentVariables</key><dict><key>RECEIPTBOX_DATA</key><string>/Users/YOUR_USER/receiptbox/data</string></dict>
<key>RunAtLoad</key><true/>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
<key>StandardOutPath</key><string>/Users/YOUR_USER/receiptbox/deployment/backup.log</string>
<key>StandardErrorPath</key><string>/Users/YOUR_USER/receiptbox/deployment/backup-error.log</string>
</dict></plist>
