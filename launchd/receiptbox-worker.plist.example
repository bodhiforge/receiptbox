<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.example.receiptbox-worker</string>
<key>ProgramArguments</key><array><string>/opt/homebrew/bin/node</string><string>/Users/YOUR_USER/receiptbox/current/src/worker.mjs</string></array>
<key>WorkingDirectory</key><string>/Users/YOUR_USER/receiptbox/current</string>
<key>EnvironmentVariables</key><dict>
<key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
<key>RECEIPTBOX_DATA</key><string>/Users/YOUR_USER/receiptbox/data</string>
<key>RECEIPTBOX_LOCAL_AI</key><string>1</string>
</dict>
<key>KeepAlive</key><true/><key>RunAtLoad</key><true/>
<key>StandardOutPath</key><string>/Users/YOUR_USER/receiptbox/logs/worker.log</string>
<key>StandardErrorPath</key><string>/Users/YOUR_USER/receiptbox/logs/worker-error.log</string>
<key>ThrottleInterval</key><integer>10</integer>
</dict></plist>
